{
  "manifest_version": 3,
  "name": "Dictionary Search",
  "description": "Klik badge EN/ID/KR di situs target → kotak pencarian untuk mencari terjemahan dari dictionary.",
  "version": "0.1.0",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Dictionary Search — cek status & atur situs target",
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dict-search@pgd",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}